# Copy this file to `.env` and fill in what you need.
#
# Any OpenAI-compatible endpoint works. Presets:
#   openrouter | groq | gemini | openai | ollama | custom | none
#
# Without a key (and without local Ollama) the API still works and uses the
# built-in heuristic matcher. `GET /api/llm/status` shows the active mode.

LLM_PRESET=openrouter
LLM_API_KEY=
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# LLM_BASE_URL=https://openrouter.ai/api/v1   # override or use with preset=custom
LLM_TIMEOUT=30

# --- Examples (uncomment one) ---
# Groq free tier:
# LLM_PRESET=groq
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile
#
# Google Gemini free tier:
# LLM_PRESET=gemini
# LLM_API_KEY=AIza...
# LLM_MODEL=gemini-2.5-flash
#
# Local Ollama (no key needed):
# LLM_PRESET=ollama
# LLM_MODEL=llama3.1
#
# Any custom OpenAI-compatible gateway:
# LLM_PRESET=custom
# LLM_BASE_URL=https://your-gateway.example.com/v1
# LLM_API_KEY=...
# LLM_MODEL=your-model-name
